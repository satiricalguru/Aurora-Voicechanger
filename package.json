{
  "name": "aurora-voice",
  "productName": "Aurora Voice",
  "version": "0.1.0",
  "description": "Ultra low latency real-time voice changer",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "npm run dev",
    "vite": "vite",
    "build:ui": "vite build",
    "build": "npm run build:native && npm run build:driver && vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:native": "cmake -S native/aurora-core -B native/aurora-core/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/aurora-core/build -j 8",
    "test:native": "python3 native/aurora-core/tools/export_presets.py native/aurora-core/build/presets.jsonl && native/aurora-core/build/aurora_bench native/aurora-core/build/presets.jsonl",
    "build:driver": "drivers/aurora-hal/build.sh && drivers/aurora-hal/build/hal_test drivers/aurora-hal/build/AuroraHAL.driver",
    "test": "bash tests/run_all.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "framer-motion": "^14.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.aurora.voice",
    "productName": "Aurora Voice",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python/",
        "to": "python/",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "native/aurora-core/build/libaurora_core.dylib",
        "to": "python/libaurora_core.dylib"
      },
      {
        "from": "drivers/aurora-hal/",
        "to": "drivers/aurora-hal/",
        "filter": [
          "build/AuroraHAL.driver/**/*",
          "install.sh",
          "uninstall.sh"
        ]
      },
      {
        "from": "models/",
        "to": "models/",
        "filter": [
          "**/*.onnx"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "entitlements": "build/entitlements.plist",
      "entitlementsInherit": "build/entitlements.plist",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Aurora Voice needs your microphone to change your voice in real time.",
        "NSAudioCaptureUsageDescription": "Aurora Voice records audio from other apps (YouTube, games) when you choose Mac audio in the Recorder."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "release"
    }
  }
}
